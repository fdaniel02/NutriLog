@using System.Globalization
<section class="card summary" aria-label="@Label">
    <div class="summary-energy">
        <span class="summary-value">@NutrientFormat.Total(Totals[Nutrients.Energy])</span>
        <span class="muted">kcal</span>
        @TargetOf(Nutrients.Energy)
        @BarOf(Nutrients.Energy)
    </div>
    <dl class="summary-macros">
        @foreach (var id in Headline)
        {
            var nutrient = ById[id];
            <div>
                <dt>@nutrient.Name</dt>
                <dd>@NutrientFormat.WithUnit(Totals[id], nutrient.Unit)@TargetOf(id)@BarOf(id)</dd>
            </div>
        }
    </dl>
    <details class="all-nutrients">
        <summary>All nutrients</summary>
        <NutrientTables Totals="Totals" Targets="Targets" Exclude="TablesExclude" />
        <p class="muted note">≥: some foods have no value for it; ?: none has.</p>
    </details>
</section>

@code {
    public static readonly IReadOnlyList<string> Headline = [Nutrients.Protein, Nutrients.Carbohydrate, Nutrients.Fat, Nutrients.Fibre];

    static readonly IReadOnlyList<string> TablesExclude = [Nutrients.Energy, .. Headline];

    static readonly Dictionary<string, Nutrient> ById = Nutrients.All.ToDictionary(n => n.Id);

    [Parameter, EditorRequired]
    public NutrientTotals Totals { get; set; } = NutrientTotals.Empty;

    [Parameter]
    public string Label { get; set; } = "Total";

    // The day's targets; entries have none.
    [Parameter]
    public DayTargets? Targets { get; set; }

    RenderFragment? TargetOf(string nutrientId) => TargetOf(Targets, Totals, nutrientId);

    RenderFragment? BarOf(string nutrientId) => BarOf(Targets, Totals, nutrientId);

    internal static RenderFragment? TargetOf(DayTargets? targets, NutrientTotals totals, string nutrientId)
    {
        if (targets?[nutrientId] is not { } range)
            return null;
        var status = range.Evaluate(totals[nutrientId]);
        return @<span class="target @status?.ToString().ToLowerInvariant()">
            <span class="visually-hidden">@StatusText(status), target </span>@range.Describe()
        </span>;
    }

    internal static RenderFragment? BarOf(DayTargets? targets, NutrientTotals totals, string nutrientId)
    {
        if (targets?[nutrientId] is not { } range)
            return null;
        var bar = TargetBar.For(range, totals[nutrientId]);
        return @<span class="target-bar @bar.Status?.ToString().ToLowerInvariant()" aria-hidden="true">
            <span class="target-fill" style="width:@Percent(bar.Fill)"></span>
            @if (bar.MinimumMark is { } mark)
            {
                <span class="target-minimum" style="left:@Percent(mark)"></span>
            }
        </span>;
    }

    static string Percent(double fraction) => (fraction * 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    static string StatusText(TargetStatus? status) => status switch
    {
        TargetStatus.Under => "under",
        TargetStatus.Within => "within",
        TargetStatus.Over => "over",
        _ => "not known against"
    };
}
