@page "/entry/{EntryId:int}"
@rendermode InteractiveServer
@inject IDiary Diary
@inject IRecipes Recipes
@inject Clock Clock
@inject NavigationManager Navigation

<PageTitle>NutriLog · Edit entry</PageTitle>

@if (recipeEntry is not null)
{
    <nav class="back-nav">
        <a href="@DiaryUrls.Day(recipeEntry.Date)">‹ @DiaryUrls.DayTitle(recipeEntry.Date, Clock.Today)</a>
    </nav>
    <h1>Edit entry</h1>
    <ServingsForm Name="@recipeEntry.RecipeName" PerServing="recipeEntry.PerServing" InitialServings="recipeEntry.Servings"
                  InitialTime="recipeEntry.Time" SubmitLabel="Save" OnSubmit="SaveRecipeAsync">
        <button type="button" class="button danger" @onclick="DeleteAsync">Delete</button>
    </ServingsForm>
    <p class="muted note">The nutrients are the recipe's when it was logged; a later change to the recipe doesn't change them.</p>
}
else if (entry is null)
{
    @if (loaded)
    {
        <h1>Entry not found</h1>
        <p><a href="">Back to today</a></p>
    }
}
else
{
    <nav class="back-nav">
        <a href="@DiaryUrls.Day(entry.Date)">‹ @DiaryUrls.DayTitle(entry.Date, Clock.Today)</a>
    </nav>
    <h1>Edit entry</h1>
    <AmountForm Food="entry.Food" Initial="entry.Amount" InitialTime="entry.Time" SubmitLabel="Save" OnSubmit="SaveAsync">
        <button type="button" class="button danger" @onclick="DeleteAsync">Delete</button>
    </AmountForm>
}

@code {
    [Parameter]
    public int EntryId { get; set; }

    EntryDetails? entry;
    RecipeEntryDetails? recipeEntry;
    bool loaded;

    protected override async Task OnParametersSetAsync()
    {
        entry = await Diary.GetEntryAsync(EntryId);
        recipeEntry = entry is null ? await Recipes.GetEntryAsync(EntryId) : null;
        loaded = true;
    }

    async Task SaveAsync((TimeOnly Time, EntryAmount Amount) input)
    {
        await Diary.UpdateEntryAsync(EntryId, input.Time, input.Amount);
        Navigation.NavigateTo(DiaryUrls.Day(entry!.Date));
    }

    async Task SaveRecipeAsync((TimeOnly Time, double Servings) input)
    {
        await Recipes.UpdateEntryAsync(EntryId, input.Time, input.Servings);
        Navigation.NavigateTo(DiaryUrls.Day(recipeEntry!.Date));
    }

    async Task DeleteAsync()
    {
        var date = entry?.Date ?? recipeEntry!.Date;
        await Diary.DeleteEntryAsync(EntryId);
        Navigation.NavigateTo(DiaryUrls.Day(date));
    }
}
