@page "/"
@rendermode InteractiveServer
@inject IDiary Diary
@inject ITargets Targets
@inject Clock Clock
@inject NavigationManager Navigation

<PageTitle>NutriLog · @title</PageTitle>

<nav class="day-nav" aria-label="Day">
    <a class="day-step" href="@DiaryUrls.Day(date.AddDays(-1))" aria-label="Previous day">‹</a>
    <div class="day-title">
        <h1>@title</h1>
        <input type="date" aria-label="Go to date" value="@DiaryUrls.Format(date)" @onchange="GoToDate" />
    </div>
    <a class="day-step" href="@DiaryUrls.Day(date.AddDays(1))" aria-label="Next day">›</a>
</nav>

@if (day is not null)
{
    <NutrientSummary Totals="day.Totals" Label="Day total" Targets="targets" />
    @if (targets?.HasTargets == true)
    {
        <p class="run-note muted">@targets.RunNote</p>
    }
    else if (targets is not null)
    {
        <p class="run-note muted"><a href="targets">Set targets</a> to see the day against them.</p>
    }

    <section class="card day-entries" aria-label="Entries">
        @if (day.Entries.Count > 0)
        {
            <ul class="entries">
                @foreach (var entry in day.Entries)
                {
                    <li>
                        <a href="@DiaryUrls.Entry(entry.Id)">
                            <span class="entry-name">@entry.Name</span>
                            <span class="entry-amount muted">@DiaryUrls.TimeOfDay(entry.Time) · @entry.Amount</span>
                            <span class="entry-energy">@NutrientFormat.WithUnit(entry.Nutrients[Nutrients.Energy], "kcal")</span>
                        </a>
                    </li>
                }
            </ul>
        }
        <a class="add-link" href="@DiaryUrls.Add(date)">+ Add food or recipe</a>
    </section>

    <details class="card copy">
        <summary>Copy from another day</summary>
        <div class="form-row">
            <label>
                From
                <input type="date" @bind="copyFrom" />
            </label>
        </div>
        <button type="button" class="button" @onclick="CopyAsync">Copy to @title.ToLowerInvariant()</button>
        @if (copyMessage is not null)
        {
            <p class="copy-message" role="status">@copyMessage</p>
        }
    </details>
}

@code {
    [SupplyParameterFromQuery(Name = "date")]
    public string? DateText { get; set; }

    DateOnly date;
    string title = "";
    DiaryDay? day;
    // Null while loading: RunStats may take up to its timeout, and the diary shouldn't wait for it.
    DayTargets? targets;
    DateOnly copyFrom;
    string? copyMessage;

    protected override async Task OnParametersSetAsync()
    {
        var today = Clock.Today;
        date = DiaryUrls.ParseDate(DateText) ?? today;
        title = DiaryUrls.DayTitle(date, today);
        copyFrom = date.AddDays(-1);
        copyMessage = null;
        targets = null;
        var targetsTask = Targets.GetDayAsync(date);
        day = await Diary.GetDayAsync(date);
        if (!targetsTask.IsCompleted)
            StateHasChanged();
        targets = await targetsTask;
    }

    void GoToDate(ChangeEventArgs e)
    {
        if (DiaryUrls.ParseDate(e.Value as string) is { } chosen)
            Navigation.NavigateTo(DiaryUrls.Day(chosen));
    }

    async Task CopyAsync()
    {
        if (copyFrom == date)
        {
            copyMessage = "Choose another day to copy from.";
            return;
        }
        var copied = await Diary.CopyAsync(copyFrom, date);
        var entries = copied == 1 ? "entry" : "entries";
        copyMessage = copied == 0
            ? $"Nothing to copy on {DiaryUrls.DayTitle(copyFrom, Clock.Today)}."
            : $"Copied {copied} {entries}.";
        day = await Diary.GetDayAsync(date);
    }
}
