<form class="card amount-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <h2>@Name</h2>
    <div class="form-row">
        <label>
            Servings
            <input type="number" inputmode="decimal" step="any" min="0" required @bind="servings" />
        </label>
        <label>
            Time
            <input type="time" required @bind="time" @bind:format="HH:mm" />
        </label>
    </div>
    @if (Servings is { } s)
    {
        var totals = NutrientTotals.ForServings(PerServing, s);
        <p class="amount-preview">
            @NutrientFormat.Servings(s):
            @NutrientFormat.WithUnit(totals[Nutrients.Energy], "kcal") ·
            P @NutrientFormat.WithUnit(totals[Nutrients.Protein], "g") ·
            C @NutrientFormat.WithUnit(totals[Nutrients.Carbohydrate], "g") ·
            F @NutrientFormat.WithUnit(totals[Nutrients.Fat], "g")
        </p>
    }
    else
    {
        <p class="amount-preview muted">Enter a number of servings above 0.</p>
    }
    <div class="form-actions">
        <button type="submit" class="button primary" disabled="@(Servings is null || time is null || busy)">@SubmitLabel</button>
        @ChildContent
    </div>
</form>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, (double PerServing, bool Complete)> PerServing { get; set; } = null!;

    [Parameter]
    public double InitialServings { get; set; } = 1;

    [Parameter, EditorRequired]
    public TimeOnly InitialTime { get; set; }

    [Parameter]
    public string SubmitLabel { get; set; } = "Add";

    [Parameter]
    public EventCallback<(TimeOnly Time, double Servings)> OnSubmit { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    double? servings;
    TimeOnly? time;
    bool busy;
    bool initialised;

    protected override void OnParametersSet()
    {
        if (initialised)
            return;
        initialised = true;
        servings = InitialServings;
        time = InitialTime;
    }

    double? Servings => servings is { } s && s > 0 && double.IsFinite(s) ? s : null;

    async Task SubmitAsync()
    {
        if (Servings is not { } s || time is not { } eaten || busy)
            return;
        busy = true;
        try
        {
            await OnSubmit.InvokeAsync((eaten, s));
        }
        finally
        {
            busy = false;
        }
    }
}
