<form class="card amount-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <h2>@Name</h2>
    <div class="form-row">
        <label>
            Amount
            <input type="number" inputmode="decimal" step="any" min="0" required @bind="quantity" />
        </label>
        <label>
            Unit
            <select @bind="unit" @bind:after="ConvertQuantity">
                <option value="@RecipeUnit.Servings">servings (@NutrientFormat.Amount(Snapshot.ServingGrams) g each)</option>
                <option value="@RecipeUnit.Grams">g</option>
            </select>
        </label>
        <label>
            Time
            <input type="time" required @bind="time" />
        </label>
        @if (DateChanged.HasDelegate)
        {
            <label>
                Date
                <input type="date" required value="@(Date is { } d ? DiaryUrls.Format(d) : "")" @onchange="ChangeDateAsync" />
            </label>
        }
    </div>
    @if (Amount is { } amount)
    {
        var totals = Snapshot.Nutrients(amount);
        <p class="amount-preview">
            @Snapshot.Describe(amount):
            @NutrientFormat.WithUnit(totals[Nutrients.Energy], "kcal") ·
            P @NutrientFormat.WithUnit(totals[Nutrients.Protein], "g") ·
            C @NutrientFormat.WithUnit(totals[Nutrients.Carbohydrate], "g") ·
            F @NutrientFormat.WithUnit(totals[Nutrients.Fat], "g")
        </p>
    }
    else
    {
        <p class="amount-preview muted">Enter an amount above 0.</p>
    }
    <div class="form-actions">
        <button type="submit" class="button primary" disabled="@(!CanSubmit)">@SubmitLabel</button>
        @ChildContent
    </div>
</form>
@if (Amount is { } shown)
{
    <NutritionCard Totals="Snapshot.Nutrients(shown)" Caption="@Snapshot.Describe(shown)" />
}

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter, EditorRequired]
    public RecipeSnapshot Snapshot { get; set; } = null!;

    [Parameter]
    public RecipeAmount InitialAmount { get; set; } = RecipeAmount.InServings(1);

    [Parameter, EditorRequired]
    public TimeOnly InitialTime { get; set; }

    [Parameter]
    public string SubmitLabel { get; set; } = "Add";

    // Shown only with DateChanged: the entry page edits an entry on its own day.
    [Parameter]
    public DateOnly? Date { get; set; }

    [Parameter]
    public EventCallback<DateOnly?> DateChanged { get; set; }

    [Parameter]
    public EventCallback<(TimeOnly Time, RecipeAmount Amount)> OnSubmit { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    double? quantity;
    RecipeUnit unit;
    TimeOnly? time;
    bool busy;
    bool initialised;

    protected override void OnParametersSet()
    {
        if (initialised)
            return;
        initialised = true;
        quantity = InitialAmount.Quantity;
        unit = InitialAmount.Unit;
        time = InitialTime;
    }

    RecipeAmount? Amount => quantity is { } q && q > 0 && double.IsFinite(q) ? new RecipeAmount(q, unit) : null;

    // Keeps the amount the same when only its unit changes.
    void ConvertQuantity()
    {
        if (quantity is not { } q || q <= 0 || !double.IsFinite(q))
            return;
        quantity = unit == RecipeUnit.Grams
            ? Math.Round(q * Snapshot.ServingGrams)
            : Math.Round(q / Snapshot.ServingGrams, 2);
    }

    bool CanSubmit => Amount is not null && time is not null && (Date is not null || !DateChanged.HasDelegate) && !busy;

    Task ChangeDateAsync(ChangeEventArgs e) => DateChanged.InvokeAsync(DiaryUrls.ParseDate(e.Value as string));

    async Task SubmitAsync()
    {
        if (!CanSubmit || Amount is not { } amount || time is not { } eaten)
            return;
        busy = true;
        try
        {
            await OnSubmit.InvokeAsync((eaten, amount));
        }
        finally
        {
            busy = false;
        }
    }
}
