@inject ISourceQueries Queries

@if (lines is { Count: > 0 })
{
    <footer class="source-footer">
        @foreach (var line in lines)
        {
            <p>@line</p>
        }
    </footer>
}

@code {
    IReadOnlyList<string>? lines;

    protected override async Task OnInitializedAsync() =>
        lines = SourceReference.Lines(await Queries.ImportedVersionsAsync(), await Queries.HasOpenFoodFactsAsync());
}
